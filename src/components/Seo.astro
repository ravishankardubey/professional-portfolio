---
import { profile } from '../data/profile';
import type { PageSeo } from '../data/profile';
import { withBase } from '../utils/url';

interface Props {
  seo: PageSeo;
  noindex?: boolean;
}

const { seo, noindex = false } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, site).href;
const image = new URL(withBase(seo.image), site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.contact.email}`,
  url: new URL(withBase('/'), site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Bangalore', addressCountry: 'IN' },
  worksFor: { '@type': 'Organization', name: 'VMware by Broadcom' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'GLA University' },
  knowsAbout: profile.skills.flatMap((group) => group.items).slice(0, 12),
  sameAs: [profile.contact.linkedin, profile.contact.github],
};
---
<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta name="author" content={profile.name} />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={profile.name} />
<meta property="og:locale" content="en_IN" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
<meta property="profile:first_name" content="Ravi Shankar" />
<meta property="profile:last_name" content="Dubey" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={image} />

{!noindex && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
